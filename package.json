{
  "name": "contas-adm",
  "productName": "Studios Miau",
  "version": "1.0.0",
  "description": "Painel de planejamento e publicação de Instagram da Studios Miau",
  "author": "Studios Miau",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.studiosmiau.contasadm",
    "productName": "Studios Miau",
    "files": ["main.js", "preload.js", "timer.html", "app/**", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "artifactName": "Contas-ADM-${os}-${version}.${ext}",
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Studios Miau" },
    "mac": { "target": "dmg", "icon": "build/icon.png", "category": "public.app-category.productivity", "identity": null, "minimumSystemVersion": "10.15" }
  }
}
